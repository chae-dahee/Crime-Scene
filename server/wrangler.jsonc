{
  "name": "crime-scene-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "Session" }]
  },
  "exports": { "Session": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "ALLOWED_ORIGINS": "https://chae-dahee.github.io"
  }
}
